{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@alef-runtime/mcp": [
        "./packages/mcp/src/index.ts"
      ],
      "@alef-runtime/api": [
        "./packages/api/src/index.ts"
      ],
      "@alef-runtime/api/core": [
        "./packages/api/src/core/index.ts"
      ],
      "@alef-runtime/api/app": [
        "./packages/api/src/desktop/app.ts"
      ],
      "@alef-runtime/api/window": [
        "./packages/api/src/desktop/window.ts"
      ],
      "@alef-runtime/api/fs": [
        "./packages/api/src/data/fs.ts"
      ],
      "@alef-runtime/api/store": [
        "./packages/api/src/data/store.ts"
      ],
      "@alef-runtime/api/log": [
        "./packages/api/src/data/log.ts"
      ],
      "@alef-runtime/api/path": [
        "./packages/api/src/system/path.ts"
      ],
      "@alef-runtime/api/types": [
        "./packages/api/types/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "packages/api/src",
    "packages/mcp/src"
  ]
}
