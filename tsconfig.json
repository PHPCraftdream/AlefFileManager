{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@alef-tron/mcp": [
        "./packages/mcp/src/index.ts"
      ],
      "@alef-tron/api": [
        "./packages/api/src/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "frontend/src",
    "packages/api/src",
    "packages/mcp/src",
    "rsbuild.config.ts"
  ]
}
