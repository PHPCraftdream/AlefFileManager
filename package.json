{
  "name": "alef-runtime",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen:types": "node scripts/types/gen-types.mjs",
    "check:types": "node scripts/types/gen-types.mjs --check",
    "test:types": "node --test scripts/types/gen-types.test.mjs",
    "test:ci": "node --test scripts/ci/*.test.mjs scripts/ci/e2e/*.test.mjs",
    "test:release": "node --test scripts/release/tests/*.test.mjs",
    "test:assets": "node --test backend/crates/alef-runtime/src/bridge/assets/origin/*.test.mjs",
    "test:api": "node --experimental-strip-types --test packages/api/test/*.test.mjs packages/api/test/*/*.test.mjs packages/api/test/*/*/*.test.mjs tests/e2e/*.test.mjs",
    "test:mcp": "node --experimental-strip-types --test packages/mcp/test/*.test.mjs",
    "test:tools": "node --experimental-strip-types --test packages/tools/test/*.test.mjs",
    "test:create": "node --experimental-strip-types --test packages/create-alef-runtime/test/*.test.mjs",
    "test:runtime": "node --experimental-strip-types --test packages/runtime/test/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/cargo.mjs build --locked --workspace",
    "test:rust": "node scripts/cargo.mjs test --locked --workspace --no-fail-fast",
    "lint": "oxlint --config .oxlintrc.json packages scripts tests --max-warnings 0",
    "lint:structure": "node scripts/quality/check-structure.mjs",
    "test:structure": "node --test scripts/quality/check-structure.test.mjs",
    "mutate": "node scripts/quality/mutate.mjs",
    "test:mutate": "node --test scripts/quality/mutate.test.mjs",
    "check": "npm run lint && npm run lint:structure && npm run typecheck &&node scripts/cargo.mjs clippy --locked --workspace --all-targets -- -D warnings"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.13.6",
    "oxlint": "1.85.0"
  }
}
