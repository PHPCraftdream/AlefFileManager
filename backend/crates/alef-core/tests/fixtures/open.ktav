id: com.example.notes
name: Notes
version:: 1.0.0
windows: [
    {
        label: main
        url: /
        width: 70%work
        height: 80%work
        monitor: cursor
        position: center
        restore: true
    }
]
external: {
    connect: [ https://api.example.com ]
    load: {
        scripts: []
        styles: []
        images: []
        fonts: []
        media: []
        frames: []
    }
}
permissions: {
    fs: {
        read: [ /notes ]
        write: []
    }
    cli: {
        exec: [ git ]
    }
    net: {
        http: []
        socket: []
    }
    shell: {
        openExternal: []
    }
    clipboard: {
        read: false
    }
    shortcut: {
        global: false
    }
    secrets: false
    app: {
        env: []
    }
}
