id: org.alef.e2e.modules.service
name: Alef e2e service
version:: 1.0.0
windows: []
external: {
    connect: []
    load: {
        scripts: []
        styles: []
        images: []
        fonts: []
        media: []
        frames: []
    }
}
permissions: {
    fs: {
        read: []
        write: []
    }
    cli: {
        exec: []
    }
    net: {
        http: []
        socket: [ listen:127.0.0.1:{{PORT}} ]
    }
    shell: {
        openExternal: []
    }
    clipboard: {
        read: false
    }
    shortcut: {
        global: false
    }
    secrets: false
    app: {
        env: []
    }
}
